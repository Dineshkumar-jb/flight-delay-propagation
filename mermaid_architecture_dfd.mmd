graph TD
    %% Nodes styling
    classDef inputStyle fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000;
    classDef processStyle fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000;
    classDef mainStyle fill:#e6e6e6,stroke:#000000,stroke-width:2px,color:#000,font-weight:bold;
    classDef outputStyle fill:#e6e6e6,stroke:#000000,stroke-width:2.5px,color:#000,font-weight:bold;

    RawData["Raw Flight Operations Data<br/>Origin, Destination, Delay,<br/>Airport Coordinates<br/>(US DOT BTS / Kaggle)"]:::inputStyle

    subgraph DataPrep ["Data Preparation"]
        DataClean["Data Cleaning<br/>& Structuring"]:::processStyle
        FlightChain["Flight Chain Construction<br/>&lt;Airport, Delay-Status&gt; Sequences"]:::processStyle
        CoordAttach["Airport Coordinate<br/>Attachment"]:::processStyle
    end

    subgraph SPM ["Sequential Pattern Mining (SPM)"]
        SeqDist["Sequence Distance<br/>(Edit / Alignment)"]:::processStyle
        GSP["GSP<br/>(Apriori-like)"]:::processStyle
        PrefixSpan["PrefixSpan<br/>(Pattern-Growth)"]:::processStyle
    end

    subgraph SDM ["Spatial Data Mining (SDM)"]
        SpatialRule["Spatial Association<br/>Rule Mining"]:::processStyle
        STDBSCAN["ST-DBSCAN<br/>(Spatio-Temporal Clustering)"]:::processStyle
    end

    Integration["Spatio-Sequential Integration<br/>Merge Sequences with Spatial Clusters"]:::mainStyle

    subgraph Vis ["Visualization"]
        DelayMap["Interactive Delay Map<br/>(Folium / Leaflet)"]:::processStyle
        NetGraph["Airport Network Graph<br/>(NetworkX)"]:::processStyle
    end

    subgraph Eval ["Evaluation"]
        MLClassifier["SVM / Random Forest<br/>Classifier"]:::processStyle
        Silhouette["Silhouette Score"]:::processStyle
        SuppConf["Support / Confidence"]:::processStyle
    end

    FinalOut["Final Output:<br/>Delay-Propagation Patterns +<br/>Spatial Hotspot Insights"]:::outputStyle

    %% Flow connections
    RawData --> DataClean
    DataClean --> FlightChain
    FlightChain --> CoordAttach

    CoordAttach --> SeqDist
    CoordAttach --> GSP
    CoordAttach --> PrefixSpan
    CoordAttach --> SpatialRule
    CoordAttach --> STDBSCAN

    SeqDist --> Integration
    GSP --> Integration
    PrefixSpan --> Integration
    SpatialRule --> Integration
    STDBSCAN --> Integration

    Integration --> DelayMap
    Integration --> NetGraph
    Integration --> MLClassifier
    Integration --> Silhouette
    Integration --> SuppConf

    DelayMap --> FinalOut
    NetGraph --> FinalOut
    MLClassifier --> FinalOut
    Silhouette --> FinalOut
    SuppConf --> FinalOut
