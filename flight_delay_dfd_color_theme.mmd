graph TD
    %% Monochrome/Grayscale Color Palette matching reference image
    classDef inputStyle fill:#ffffff,stroke:#000000,stroke-width:1.8px,color:#000000,font-weight:bold;
    classDef processStyle fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000;
    classDef mainStyle fill:#e6e6e6,stroke:#000000,stroke-width:2.2px,color:#000000,font-weight:bold;
    classDef outputStyle fill:#e6e6e6,stroke:#000000,stroke-width:2.8px,color:#000000,font-weight:bold;

    E1["External Entity [E1]<br/>U.S. DOT BTS Flight Telemetry<br/>& Airport Coordinate Data Source"]:::inputStyle

    subgraph P1 ["Process 1.0: Data Preparation & Preprocessing"]
        P1_1["1.1 Multi-Leg Journey Sessionization<br/>(Group by Aircraft Tail Number)"]:::processStyle
        P1_2["1.2 Turnaround Buffer & Carryover Delay Extraction<br/>(Calculate B_turnaround & D_carryover)"]:::processStyle
        P1_3["1.3 Airport Spatial Coordinate Attachment<br/>(Attach Latitude & Longitude Centroids)"]:::processStyle
    end

    subgraph SPM ["Process 2.0: Sequential Pattern Mining (SPM)"]
        P2_1["2.1 Sequence Distance<br/>(Levenshtein Edit Alignment)"]:::processStyle
        P2_2["2.2 GSP Pattern Mining<br/>(Apriori Candidate BFS)"]:::processStyle
        P2_3["2.3 PrefixSpan Pattern Mining<br/>(Pattern Growth DFS)"]:::processStyle
    end

    subgraph SDM ["Process 3.0: Spatial Data Mining (SDM)"]
        P3_1["3.1 Haversine Distance<br/>& Association Mining"]:::processStyle
        P3_2["3.2 Spatial Clustering<br/>(Haversine DBSCAN & ST-DBSCAN)"]:::processStyle
    end

    P4["Process 4.0: Spatio-Sequential Integration<br/>Merge Sequential Delay Trajectories with Spatial Airport Clusters"]:::mainStyle

    subgraph Vis ["Visualization & Mapping"]
        P5_1["5.1 Interactive Delay Map<br/>(Offline Leaflet Dashboard)"]:::processStyle
        P5_2["5.2 Airport Network Graph<br/>(NetworkX Centrality)"]:::processStyle
    end

    subgraph Eval ["Evaluation & Predictive ML"]
        P5_3["5.3 Spatio-Sequential ML<br/>(SVM / Random Forest / GB)"]:::processStyle
        P5_4["5.4 Silhouette Score<br/>Spatial Cluster Validation"]:::processStyle
        P5_5["5.5 Support / Confidence<br/>Sequence Rule Metrics"]:::processStyle
    end

    FinalSink["Final Output Sink [E2]:<br/>Delay-Propagation Patterns + Spatial Hotspot Insights<br/>& Interactive Aviation Dashboard"]:::outputStyle

    %% Data Flow Connections
    E1 --> P1_1
    P1_1 --> P1_2
    P1_2 --> P1_3

    P1_3 --> P2_1
    P1_3 --> P2_2
    P1_3 --> P2_3
    P1_3 --> P3_1
    P1_3 --> P3_2

    P2_1 --> P4
    P2_2 --> P4
    P2_3 --> P4
    P3_1 --> P4
    P3_2 --> P4

    P4 --> P5_1
    P4 --> P5_2
    P4 --> P5_3
    P4 --> P5_4
    P4 --> P5_5

    P5_1 --> FinalSink
    P5_2 --> FinalSink
    P5_3 --> FinalSink
    P5_4 --> FinalSink
    P5_5 --> FinalSink
